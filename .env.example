# LLM (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SLOWLOG_TABLE=slowlog_v2
CLICKHOUSE_LOG_TABLE=log
CLICKHOUSE_NODE_METRIC_TABLE=es_node_metric

ES_HOST=
ES_PORT=9200
ES_USER=
ES_PASSWORD=

# Kafka consumer
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=slowlog
KAFKA_GROUP_ID=clusterdoctor

# flush 설정 (주 조건: 시간, 부 조건: 개수)
FLUSH_INTERVAL_SECONDS=30
FLUSH_MAX_SIZE=100

# flush 시 ClickHouse 조회 범위 (현재 기준 N분 전)
LOOKBACK_START_MINUTES=5
LOOKBACK_END_MINUTES=1

# litellm이 import 시점에 GitHub에서 비용 데이터를 받아오는 것을 막는다.
LITELLM_LOCAL_MODEL_COST_MAP=True
