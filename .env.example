# LLM provider 선택 - 누구에게 물어볼지: gemini | nvidia
LLM_PROVIDER=gemini

# 분석 방식 - 어떻게 물어볼지: single | graph
#   single -- 로그 전체를 한 프롬프트에 담아 1회 호출 (빠름, 소스당 200건에서 잘림)
#   graph  -- 1분 구간마다 분석 후 종합 (누락 없음, 구간 수만큼 호출)
# LLM_PROVIDER와 직교한다. graph 모드도 위에서 고른 provider를 쓴다.
ANALYSIS_MODE=single

# 선택한 provider의 키만 필수. 나머지는 비워둬도 부팅된다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SLOWLOG_TABLE=slowlog_v2
CLICKHOUSE_LOG_TABLE=log
CLICKHOUSE_NODE_METRIC_TABLE=es_node_metric

# litellm이 import 시점에 GitHub에서 비용 데이터를 받아오는 것을 막는다.
# 어댑터 모듈이 기본값으로 설정하지만, 명시해두는 편이 낫다.
LITELLM_LOCAL_MODEL_COST_MAP=True
