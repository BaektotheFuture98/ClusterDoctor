# ── LLM ───────────────────────────────────────────────────────────
# 사용할 provider를 여기서 고른다: gemini | nvidia_nim
# 고른 provider의 API 키만 필수다. 비어 있으면 기동 시
# ConfigurationError로 중단된다. 쓰지 않는 쪽은 비워 둬도 된다.
LLM_PROVIDER=nvidia_nim

# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# NVIDIA NIM
# gemma-4-31b-it는 thinking(reasoning_effort)을 지원하지 않는다. 추론은
# 프롬프트로 유도한다 — langgraph/prompts.py의 구획 CoT를 볼 것.
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it

# 경로의 데이터베이스가 아래 네 테이블이 실제로 있는 곳이어야 한다. 같은 이름의
# 테이블이 다른 DB에도 있으면 엉뚱한 쪽을 조회해도 성공하고 오래된 데이터만
# 돌아온다 — 어디에도 오류가 남지 않는 실패라 특히 조심할 것.
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/packetbeat
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SLOWLOG_TABLE=slowlog_v2
CLICKHOUSE_LOG_TABLE=log
CLICKHOUSE_NODE_METRIC_TABLE=es_node_metric
# 노드 로그 테이블. 현재 적재 범위는 **마스터 노드 로그**다 — 데이터 노드
# 로그는 여기 들어오지 않고 get_node_logs(SSH)로 수집한다.
# 컬럼: timestamp, job, service_name, node, node_role, level,
#       detected_level, logger, filename, host, line
CLICKHOUSE_NODE_LOG_TABLE=loki_logs

# 필수. agent의 첫 단계가 cluster_health()라 비어 있으면 기동 시
# ConfigurationError로 중단된다.
ES_HOST=
ES_PORT=9200
ES_USER=
ES_PASSWORD=

# SSH (ES 노드 로그 수집)
# 비워 두면 get_node_logs / analyze_logs 내 마스터 로그 수집을 건너뛴다.
SSH_USER=
SSH_PASSWORD=
SSH_PORT=22

# Kafka consumer
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=slowlog
KAFKA_GROUP_ID=clusterdoctor
# Kafka 연결 확인이 연속으로 실패할 때 종료까지 기다릴 시간(초). 양수만 허용.
# 메시지가 없는 정상 상태에는 적용하지 않는다.
KAFKA_FAILURE_TIMEOUT_SECONDS=300

# 애플리케이션 로그(app.log)를 저장할 디렉터리.
# 미지정 또는 빈 값이면 logs. 상대 경로는 작업 디렉터리 기준.
# Linux 절대 경로 예: /var/log/clusterdoctor
LOG_DIR=logs

# app.log 로테이션. 파일이 LOG_MAX_BYTES(바이트)를 넘으면 app.log.1, app.log.2 …로
# 넘기고 LOG_BACKUP_COUNT개까지만 남긴다. 둘 다 양수만 허용, 비우면 기본값
# (10MB, 5개). 총량은 대략 (LOG_BACKUP_COUNT + 1) * LOG_MAX_BYTES다.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# 진단 리포트 HTML을 저장할 디렉터리. 진단 한 건이 파일 한 개다
# (report-YYYYMMDD-HHMMSS.html). 상대 경로는 작업 디렉터리 기준.
# 미지정 또는 빈 값이면 reports. Linux 절대 경로 예: /var/lib/clusterdoctor/reports
REPORT_DIR=reports

# 리포트를 SFTP로 다른 서버에도 올린다. REPORT_SFTP_HOST가 비어 있으면 꺼진다
# (로컬 REPORT_DIR에만 저장). 켜면 REPORT_SFTP_USER, REPORT_SFTP_REMOTE_DIR,
# 그리고 REPORT_SFTP_PASSWORD 또는 REPORT_SFTP_KEY_FILE이 필요하다. 업로드가
# 실패해도 로컬 파일은 남고 분석은 계속된다. 업로드한 파일에는 실제 IP·회사·사용자
# 값이 들어 있으므로 원격 디렉터리 접근 권한을 제한할 것.
REPORT_SFTP_HOST=
REPORT_SFTP_PORT=22
REPORT_SFTP_USER=
REPORT_SFTP_PASSWORD=
# 비밀번호 대신 개인 키로 인증할 때의 키 파일 경로(비밀번호를 쓰지 않으면 이쪽을 권장).
# 키에 패스프레이즈가 있으면 REPORT_SFTP_PASSWORD에 패스프레이즈를 넣는다. 키 인증을 먼저 시도한다.
REPORT_SFTP_KEY_FILE=
# 올릴 원격 디렉터리(리눅스 서버의 POSIX 경로). 없으면 만든다. 예: /var/lib/clusterdoctor/reports
REPORT_SFTP_REMOTE_DIR=
# 서버 호스트 키 검증용 known_hosts 파일. 지정하면 목록에 없는 서버는 거부하고,
# 비우면 모든 호스트 키를 받아들인다(기동 시 경고).
REPORT_SFTP_KNOWN_HOSTS=
REPORT_SFTP_TIMEOUT_SECONDS=10

# litellm이 import 시점에 GitHub에서 비용 데이터를 받아오는 것을 막는다.
LITELLM_LOCAL_MODEL_COST_MAP=True
